<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DeskOS — Browser Prototype</title>
<style>
:root{color-scheme:dark;--ink:#f3f3f8;--muted:#a7a7b7;--glass:rgba(22,23,34,.76);--line:rgba(255,255,255,.14);--accent:#a78bfa;--accent2:#69e6c3;--wall:radial-gradient(ellipse at 75% 20%,#574490 0,transparent 42%),radial-gradient(ellipse at 20% 85%,#145b72 0,transparent 38%),linear-gradient(135deg,#11121d,#19132b 58%,#101b28);font:14px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;color:var(--ink);height:100vh;overflow:hidden;background:var(--wall);transition:.3s}button,input{font:inherit;color:inherit}button{cursor:pointer}.desktop{height:100%;position:relative;padding:42px 24px 86px}.topbar{position:absolute;inset:0 0 auto;height:36px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;background:rgba(8,9,15,.3);backdrop-filter:blur(14px);font-size:12px;color:#eee;z-index:5}.top-left,.top-right{display:flex;align-items:center;gap:16px}.brand{font-weight:750;letter-spacing:.04em}.status{color:#d6d4e5}.desktop-icons{position:absolute;left:22px;top:58px;display:grid;gap:12px;width:80px}.desk-icon{border:0;background:transparent;display:grid;justify-items:center;gap:5px;color:white;text-shadow:0 2px 8px #000;padding:8px 4px;border-radius:12px}.desk-icon:hover,.desk-icon:focus-visible{background:#ffffff20;outline:none}.emoji{font-size:30px;filter:drop-shadow(0 4px 6px #0005)}.desk-icon span:last-child{font-size:11px}.window{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(960px,calc(100vw - 150px));height:min(650px,calc(100vh - 150px));min-height:370px;background:var(--glass);border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 100px #0007,0 2px 10px #0003;backdrop-filter:blur(28px);display:flex;flex-direction:column;overflow:hidden;resize:both;transition:opacity .18s,transform .18s;z-index:2}.window.hidden{display:none}.window.max{inset:42px 14px 82px;width:auto;height:auto;transform:none}.titlebar{height:48px;flex:0 0 48px;display:flex;align-items:center;padding:0 14px;gap:14px;border-bottom:1px solid var(--line);background:#ffffff08;user-select:none}.traffic{display:flex;gap:7px}.traffic button{border:0;width:12px;height:12px;border-radius:50%;padding:0}.close{background:#ff625b}.minimize{background:#ffbd44}.maximize{background:#32c852}.win-title{font-size:13px;font-weight:650;color:#ebe9f2}.window-actions{margin-left:auto;color:var(--muted);display:flex;gap:10px}.window-actions button{border:0;background:transparent;color:inherit;padding:4px 8px;border-radius:7px}.window-actions button:hover{background:#ffffff14}.tabs{height:43px;flex:0 0 43px;display:flex;gap:5px;align-items:end;padding:0 12px;background:#08091026}.tab{height:34px;min-width:150px;max-width:220px;padding:0 10px;border-radius:10px 10px 0 0;background:#ffffff0c;display:flex;align-items:center;gap:8px;color:#c7c5d2;cursor:pointer}.tab.active{background:#ffffff19;color:white}.tab-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.tab-x{border:0;background:none;color:inherit;padding:2px 4px;border-radius:5px}.tab-x:hover{background:#ffffff20}.newtab{background:none;border:0;color:#ddd;padding:5px 10px;margin-bottom:4px;border-radius:8px}.newtab:hover{background:#ffffff16}.toolbar{height:52px;flex:0 0 52px;display:flex;align-items:center;gap:8px;padding:0 14px;border-bottom:1px solid var(--line)}.navbtn{border:0;background:transparent;color:#d9d8e4;font-size:18px;width:32px;height:32px;border-radius:9px}.navbtn:hover{background:#ffffff14}.address{flex:1;min-width:80px;height:36px;border:1px solid #ffffff16;background:#08091065;border-radius:11px;display:flex;align-items:center;padding:0 11px;gap:8px}.address .lock{font-size:12px;color:var(--accent2)}.address input{width:100%;border:0;outline:0;background:transparent;color:#eee;font-size:13px}.go{border:0;background:var(--accent);color:#14111f;font-weight:700;border-radius:9px;padding:8px 13px}.go:hover{filter:brightness(1.12)}.page{flex:1;overflow:auto;background:#f5f3f9;color:#22212a;border-radius:0 0 16px 16px}.page-inner{max-width:760px;margin:0 auto;padding:36px 30px}.page-head{display:flex;align-items:center;justify-content:space-between;color:#777;font-size:12px;margin-bottom:22px}.page h1{font-size:32px;letter-spacing:-.04em;line-height:1.15;margin:0 0 12px;color:#211c32}.page p{color:#595666}.hero{padding:30px;border-radius:18px;background:linear-gradient(135deg,#ded7ff,#d8f5ee);margin:20px 0}.hero h2{font-size:22px;margin:0 0 8px;color:#29223f}.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}.chip{padding:8px 12px;background:white;border:1px solid #e8e5ef;border-radius:999px;color:#514c60}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.card{background:white;border:1px solid #e9e7ee;border-radius:14px;padding:16px;min-height:110px}.card b{display:block;margin:8px 0 5px;color:#282333}.card small{color:#777}.dock-wrap{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);z-index:4}.dock{display:flex;gap:8px;padding:9px 12px;border:1px solid #ffffff24;border-radius:20px;background:rgba(20,19,31,.66);backdrop-filter:blur(20px);box-shadow:0 12px 45px #0005}.dock button{width:48px;height:48px;border:0;background:#ffffff0b;border-radius:14px;font-size:25px;position:relative}.dock button:hover{transform:translateY(-5px);background:#ffffff1b}.dock button::after{content:attr(data-label);position:absolute;bottom:58px;left:50%;transform:translateX(-50%);padding:5px 8px;border-radius:7px;background:#101018;color:white;font-size:10px;white-space:nowrap;opacity:0;pointer-events:none}.dock button:hover::after{opacity:1}.prototype-switch{position:fixed;bottom:19px;right:18px;z-index:10;display:flex;align-items:center;gap:8px;padding:7px 10px;background:#11121be8;border:1px solid #ffffff2a;border-radius:999px;box-shadow:0 8px 30px #0006;font-size:11px}.prototype-switch button{width:26px;height:26px;border:0;border-radius:50%;background:#ffffff16}.switch-label{min-width:116px;text-align:center;color:#ddd}.toast{position:absolute;top:52px;left:50%;transform:translate(-50%,-12px);opacity:0;pointer-events:none;padding:9px 14px;background:#151622e8;border:1px solid #ffffff22;border-radius:12px;z-index:7;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.variant-classic{--wall:linear-gradient(145deg,#23486a,#447ca1 55%,#243755);--accent:#79c5ff;--glass:rgba(20,33,48,.91)}.variant-classic .window{border-radius:10px}.variant-classic .dock{border-radius:8px;background:#14273bd9}.variant-classic .titlebar{background:#21425f}.variant-studio{--wall:radial-gradient(ellipse at 50% 0,#3d315e,transparent 55%),linear-gradient(150deg,#171421,#292333);--accent:#ffb86b;--glass:rgba(26,24,34,.86)}.variant-studio .window{width:min(1050px,calc(100vw - 120px));height:min(690px,calc(100vh - 125px));left:52%}.variant-studio .desktop-icons{left:auto;right:24px}.variant-studio .dock-wrap{left:26px;bottom:50%;transform:translateY(50%)}.variant-studio .dock{flex-direction:column}.variant-studio .dock button::after{left:58px;bottom:50%;transform:translateY(50%)}.variant-studio .hero{background:linear-gradient(130deg,#fce3c7,#e8dafc)}@media(max-width:680px){.desktop{padding:42px 8px 78px}.desktop-icons{left:6px;top:48px;gap:4px}.desk-icon{padding:5px 2px}.emoji{font-size:23px}.desk-icon span:last-child{font-size:9px}.window{left:50%;top:51%;width:calc(100vw - 22px);height:calc(100vh - 148px);min-height:320px;border-radius:13px}.window.max{inset:42px 6px 78px}.titlebar{height:40px;flex-basis:40px}.tabs{padding:0 6px}.tab{min-width:110px}.toolbar{gap:3px;padding:0 7px}.navbtn{width:28px}.go{padding:8px}.page-inner{padding:23px 18px}.page h1{font-size:26px}.cards{grid-template-columns:1fr}.dock-wrap{bottom:10px}.dock{gap:4px;padding:6px}.dock button{width:42px;height:42px;font-size:22px}.prototype-switch{right:8px;bottom:76px}.variant-studio .window{left:50%;width:calc(100vw - 22px);height:calc(100vh - 148px)}.variant-studio .dock-wrap{left:50%;bottom:10px;transform:translateX(-50%)}.variant-studio .dock{flex-direction:row}.variant-studio .desktop-icons{right:6px}}
</style></head>
<body class="variant-desk">
<div class="desktop" id="desktop">
  <div class="topbar"><div class="top-left"><span class="brand">◈ DeskOS</span><span>ไฟล์</span><span>แก้ไข</span><span>หน้าต่าง</span></div><div class="top-right"><span class="status">◉ Wi-Fi</span><span class="status">🔋 94%</span><span id="clock">--:--</span></div></div>
  <div class="desktop-icons"><button class="desk-icon" data-app="browser"><span class="emoji">🌐</span><span>Browser</span></button><button class="desk-icon" data-app="files"><span class="emoji">📁</span><span>ไฟล์</span></button><button class="desk-icon" data-app="notes"><span class="emoji">📝</span><span>โน้ต</span></button></div>
  <div class="window" id="window">
    <div class="titlebar"><div class="traffic"><button class="close" title="ปิด" aria-label="ปิด"></button><button class="minimize" title="ย่อ" aria-label="ย่อ"></button><button class="maximize" title="ขยาย" aria-label="ขยาย"></button></div><span class="win-title">🌐 Desk Browser</span><div class="window-actions"><button id="share" title="แชร์">↗</button><button id="bookmark" title="บันทึกหน้า">☆</button></div></div>
    <div class="tabs" id="tabs"></div><button class="newtab" id="newtab" title="แท็บใหม่">＋</button>
    <div class="toolbar"><button class="navbtn" id="back" aria-label="ย้อนกลับ">‹</button><button class="navbtn" id="forward" aria-label="ไปข้างหน้า">›</button><button class="navbtn" id="refresh" aria-label="โหลดใหม่">↻</button><div class="address"><span class="lock">◈</span><input id="url" aria-label="ที่อยู่เว็บ" value="desk://home" spellcheck="false"></div><button class="go" id="go">ไป</button></div>
    <main class="page" id="page" tabindex="0"></main>
  </div>
  <div class="toast" id="toast"></div>
  <div class="dock-wrap"><div class="dock"><button data-app="browser" data-label="Browser">🌐</button><button data-app="files" data-label="ไฟล์">📁</button><button data-app="notes" data-label="โน้ต">📝</button><button data-app="settings" data-label="ตั้งค่า">⚙️</button></div></div>
</div>
<div class="prototype-switch" aria-label="สลับรูปแบบต้นแบบ"><button id="prev" aria-label="แบบก่อนหน้า">‹</button><span class="switch-label" id="variantLabel"></span><button id="next" aria-label="แบบถัดไป">›</button></div>
<script>
const variants=[['desk','A · Aurora Desktop'],['classic','B · Classic Workstation'],['studio','C · Studio Desk']];let variant=new URLSearchParams(location.search).get('variant')||'desk';if(!variants.some(v=>v[0]===variant))variant='desk';
const body=document.body,win=document.querySelector('#window'),urlInput=document.querySelector('#url'),page=document.querySelector('#page'),tabsEl=document.querySelector('#tabs'),toastEl=document.querySelector('#toast');let tabs=[{id:1,url:'desk://home',title:'หน้าแรก',history:['desk://home'],pos:0}],active=1,nextId=2;const pages={
' desk://home':``,
'desk://home':`<div class="page-inner"><div class="page-head"><span>DESK BROWSER · LOCAL DEMO</span><span>● ปลอดภัย</span></div><h1>ยินดีต้อนรับสู่ DeskOS</h1><p>คอมพิวเตอร์จำลองขนาดย่อม เปิดแอปและทดลองท่องเว็บในสภาพแวดล้อมเดโมได้เลย</p><div class="hero"><h2>ทุกอย่างพร้อมแล้ว ✨</h2><p>ลองพิมพ์ <b>desk://news</b> หรือ <b>desk://about</b> ในแถบที่อยู่ด้านบน หรือใช้ช่องค้นหาเพื่อค้นหาภายในเดโมนี้</p></div><div class="chips"><span class="chip">🧭 แท็บและประวัติ</span><span class="chip">🪟 หน้าต่างย่อ/ขยาย</span><span class="chip">📱 ปรับตามมือถือ</span></div><div class="cards"><div class="card">📰<b>ข่าวจำลอง</b><small>desk://news</small></div><div class="card">🌿<b>เกี่ยวกับ DeskOS</b><small>desk://about</small></div><div class="card">🔎<b>ค้นหา</b><small>พิมพ์คำที่ต้องการค้น</small></div></div></div>`,
'desk://news':`<div class="page-inner"><div class="page-head"><span>DESK DAILY</span><span>ฉบับทดลอง</span></div><h1>ข่าวจากโลกจำลอง</h1><p>เนื้อหาตัวอย่างสำหรับทดสอบการนำทางในเบราว์เซอร์จำลอง</p><div class="hero"><h2>ยานสำรวจลงจอดบนดวงจันทร์สีคราม</h2><p>นักสำรวจจำลองรายงานว่าเชื่อมต่อระบบสื่อสารและเริ่มเก็บตัวอย่างแล้ว</p></div><div class="cards"><div class="card">🌦️<b>พยากรณ์อากาศ</b><small>ฟ้าโปร่ง 24°</small></div><div class="card">🚉<b>การเดินทาง</b><small>รถไฟตรงเวลา</small></div><div class="card">🎨<b>วัฒนธรรม</b><small>นิทรรศการเปิดวันนี้</small></div></div><p style="margin-top:24px"><button class="chip" onclick="goTo('desk://home')">← กลับหน้าแรก</button></p></div>`,
'desk://about':`<div class="page-inner"><div class="page-head"><span>ABOUT</span><span>DeskOS prototype</span></div><h1>เดสก์ท็อปจำลอง</h1><p>หน้าต่างและแอปทั้งหมดทำงานในหน้าเว็บนี้ ไม่มีการเชื่อมบัญชีหรือส่งข้อมูลออก</p><div class="hero"><h2>เบราว์เซอร์นี้จำลองอะไรบ้าง?</h2><p>แท็บ, ประวัติย้อนกลับ/ไปข้างหน้า, แถบที่อยู่, การค้นหาในหน้าเดโม, ปุ่มย่อและขยายหน้าต่าง และแอปจำลอง</p></div><p><b>ข้อจำกัด:</b> URL ภายนอกจะไม่ถูกโหลด เพื่อความปลอดภัยและเพราะเว็บไซต์ส่วนใหญ่ไม่อนุญาตให้ฝังใน iframe</p></div>`,
};function current(){return tabs.find(t=>t.id===active)}function labelFor(u){if(u==='desk://home')return'หน้าแรก';if(u==='desk://news')return'ข่าว';if(u==='desk://about')return'เกี่ยวกับ';return u.replace(/^https?:\/\//,'').slice(0,19)}
function renderTabs(){tabsEl.innerHTML='';tabs.forEach(t=>{const el=document.createElement('div');el.className='tab'+(t.id===active?' active':'');el.innerHTML=`<span>🌐</span><span class="tab-label"></span><button class="tab-x" aria-label="ปิดแท็บ">×</button>`;el.querySelector('.tab-label').textContent=t.title;el.addEventListener('click',e=>{if(e.target.closest('.tab-x')){closeTab(t.id);return}active=t.id;render()});tabsEl.appendChild(el)});document.querySelector('#newtab').style.display='inline-block'}
function render(){const t=current();if(!t)return;urlInput.value=t.url;renderTabs();const content=pages[t.url];if(content!==undefined){page.innerHTML=content}else if(t.url.startsWith('search://')){const q=decodeURIComponent(t.url.slice(9));page.innerHTML=`<div class="page-inner"><div class="page-head"><span>ค้นหาใน DeskOS</span><span>ผลลัพธ์จำลอง</span></div><h1>ผลการค้นหา “${escapeHtml(q)}”</h1><p>ค้นหาเฉพาะข้อมูลภายในเดโม</p><div class="cards"><div class="card"><b>DeskOS — หน้าแรก</b><small>desk://home · ยินดีต้อนรับสู่เดสก์ท็อปจำลอง</small></div><div class="card"><b>ข่าวจำลอง</b><small>desk://news · ข่าวจากโลกจำลอง</small></div><div class="card"><b>เกี่ยวกับ</b><small>desk://about · วิธีใช้งานและข้อจำกัด</small></div></div></div>`}else{page.innerHTML=`<div class="page-inner"><div class="page-head"><span>DESK BROWSER</span><span>ℹ️ Local demo</span></div><h1>เปิดเว็บจริงไม่ได้ในโหมดจำลอง</h1><p>เบราว์เซอร์นี้ตั้งใจจำกัดไว้ที่หน้าเดโมในเครื่อง ไม่ส่งคำขอไปเว็บไซต์ภายนอก</p><div class="hero"><h2>ลองหน้าเหล่านี้แทน</h2><p><button class="chip" onclick="goTo('desk://home')">desk://home</button> <button class="chip" onclick="goTo('desk://news')">desk://news</button> <button class="chip" onclick="goTo('desk://about')">desk://about</button></p></div></div>`}}
function escapeHtml(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function goTo(value){let v=value.trim();if(!v)return;if(!v.includes('://')){if(/\s/.test(v)||!v.includes('.'))v='search://'+encodeURIComponent(v);else v='https://'+v}const t=current();t.url=v;t.title=labelFor(v);t.history=t.history.slice(0,t.pos+1);t.history.push(v);t.pos=t.history.length-1;render();if(!pages[v]&&!v.startsWith('search://'))notify('外部サイトは未接続です。デモページをご利用ください')}
function closeTab(id){if(tabs.length===1){goTo('desk://home');return}const i=tabs.findIndex(x=>x.id===id);tabs=tabs.filter(x=>x.id!==id);if(active===id)active=tabs[Math.max(0,i-1)].id;render()}
function notify(msg){toastEl.textContent=msg;toastEl.classList.add('show');clearTimeout(notify.timer);notify.timer=setTimeout(()=>toastEl.classList.remove('show'),2200)}
document.querySelector('#go').onclick=()=>goTo(urlInput.value);urlInput.addEventListener('keydown',e=>{if(e.key==='Enter')goTo(urlInput.value)});document.querySelector('#back').onclick=()=>{const t=current();if(t.pos>0){t.pos--;t.url=t.history[t.pos];t.title=labelFor(t.url);render()}};document.querySelector('#forward').onclick=()=>{const t=current();if(t.pos<t.history.length-1){t.pos++;t.url=t.history[t.pos];t.title=labelFor(t.url);render()}};document.querySelector('#refresh').onclick=()=>{render();notify('โหลดหน้าเดโมใหม่แล้ว')};document.querySelector('#newtab').onclick=()=>{const id=nextId++;tabs.push({id,url:'desk://home',title:'หน้าแรก',history:['desk://home'],pos:0});active=id;render()};document.querySelector('.close').onclick=()=>{win.classList.add('hidden');notify('ปิดหน้าต่างแล้ว — เปิดใหม่จาก Dock ได้')};document.querySelector('.minimize').onclick=()=>{win.classList.add('hidden');notify('ย่อหน้าต่างแล้ว')};document.querySelector('.maximize').onclick=()=>win.classList.toggle('max');document.querySelector('#bookmark').onclick=e=>{e.currentTarget.textContent=e.currentTarget.textContent==='☆'?'★':'☆';notify('บันทึกหน้าไว้ในเครื่องจำลองแล้ว')};document.querySelector('#share').onclick=()=>notify('แชร์ได้เฉพาะภายในต้นแบบนี้');document.querySelectorAll('[data-app]').forEach(b=>b.addEventListener('click',()=>{const app=b.dataset.app;win.classList.remove('hidden');if(app==='browser')return;if(app==='files'){page.innerHTML='<div class="page-inner"><div class="page-head"><span>ไฟล์ของฉัน</span><span>เครื่องนี้</span></div><h1>📁 ไฟล์</h1><p>โฟลเดอร์จำลองใน DeskOS</p><div class="cards"><div class="card">📂<b>เอกสาร</b><small>3 รายการ</small></div><div class="card">🖼️<b>รูปภาพ</b><small>12 รายการ</small></div><div class="card">⬇️<b>ดาวน์โหลด</b><small>ว่างเปล่า</small></div></div></div>';return}if(app==='notes'){page.innerHTML='<div class="page-inner"><div class="page-head"><span>NOTES</span><span>บันทึกในหน้านี้เท่านั้น</span></div><h1>📝 โน้ต</h1><p>ลองพิมพ์ข้อความในโน้ตจำลอง</p><textarea placeholder="เขียนโน้ตตรงนี้…" style="width:100%;height:220px;border:1px solid #ddd;border-radius:14px;padding:16px;font:inherit;resize:vertical"></textarea><p><small>โน้ตนี้ไม่ถูกบันทึกเมื่อปิดหรือรีโหลดหน้า</small></p></div>';return}if(app==='settings'){page.innerHTML='<div class="page-inner"><div class="page-head"><span>DESKOS</span><span>ตั้งค่า</span></div><h1>⚙️ ตั้งค่า</h1><div class="hero"><h2>ต้นแบบส่วนติดต่อ</h2><p>ใช้แถบเลือกด้านล่างขวาเพื่อสลับหน้าตาเดสก์ท็อป 3 แบบ</p></div><p>เวลาและสถานะแบตเตอรี่เป็นข้อมูลตกแต่ง ไม่ได้อ่านจากอุปกรณ์จริง</p></div>'}}));
function applyVariant(){body.className='variant-'+variant;document.querySelector('#variantLabel').textContent=variants.find(v=>v[0]===variant)[1];const params=new URLSearchParams(location.search);params.set('variant',variant);history.replaceState(null,'','?'+params.toString())}function moveVariant(d){let i=variants.findIndex(v=>v[0]===variant);variant=variants[(i+d+variants.length)%variants.length][0];applyVariant()}document.querySelector('#prev').onclick=()=>moveVariant(-1);document.querySelector('#next').onclick=()=>moveVariant(1);document.addEventListener('keydown',e=>{if(e.target.matches('input,textarea,[contenteditable]'))return;if(e.key==='ArrowLeft')moveVariant(-1);if(e.key==='ArrowRight')moveVariant(1)});
setInterval(()=>{document.querySelector('#clock').textContent=new Intl.DateTimeFormat('th-TH',{hour:'2-digit',minute:'2-digit'}).format(new Date())},1000);applyVariant();render();
</script></body></html>